{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "POD template manifest",
  "type": "object",
  "required": [
    "schema_version",
    "template_id",
    "product_type",
    "psd",
    "sha256",
    "mother",
    "scene_ids",
    "profile",
    "expected_instances_by_scene"
  ],
  "properties": {
    "schema_version": {
      "const": "pod-mockup/1"
    },
    "template_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "product_type": {
      "type": "string"
    },
    "psd": {
      "type": "string"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "mother": {
      "type": "string",
      "minLength": 1
    },
    "scene_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[1-9][0-9]*$"
      }
    },
    "profile": {
      "type": "object",
      "required": [
        "canvas",
        "mode",
        "fit"
      ],
      "properties": {
        "canvas": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "ppi": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "mode": {
          "enum": [
            "canvas",
            "alpha"
          ]
        },
        "fit": {
          "enum": [
            "contain",
            "cover"
          ]
        },
        "target": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "number"
          }
        }
      }
    },
    "expected_instances_by_scene": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "quality_status": {
      "type": "string"
    },
    "qa_evidence": {
      "type": "array"
    }
  }
}
